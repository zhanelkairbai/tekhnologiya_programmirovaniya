<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <title>Список задач</title>
</head>
<body>
<h1>Список задач</h1>
<button onclick="loadTasks()">Загрузить задачи</button>

Фильтр

<p id="count"></p>
<div id="result"></div>
<script>
let tasks = [];
async function loadTasks() {
    let result = document.getElementById("result");
    result.textContent = "Загрузка...";
    try {
        let response = await fetch("https://jsonplaceholder.typicode.com/todos");
        if (!response.ok) {
            throw new Error("Ошибка");
        }
        tasks = await response.json();
        let done = tasks.filter(function(task) {
            return task.completed;
        }).length;
        let notDone = tasks.length - done;
        document.getElementById("count").textContent =
            "Выполнено: " + done + ", не выполнено: " + notDone;
        showTasks(tasks);
    } catch (error) {
        result.textContent = "Ошибка загрузки";
    }
}
function showTasks(list) {
    let result = document.getElementById("result");
    result.textContent = "";
    for (let task of list) {
        let p = document.createElement("p");
        p.textContent = task.userId + ". " + task.title;
        if (task.completed) {
            p.textContent += " (Выполнено)";
        } else {
            p.textContent += " (Не выполнено)";
        }
        result.appendChild(p);
    }
}
function filterTasks() {
    let id = Number(document.getElementById("userId").value);
    if (id < 1 || id > 10 || document.getElementById("userId").value === "") {
        document.getElementById("result").textContent = "Введите ID от 1 до 10";
        return;
    }
    let filtered = tasks.filter(function(task) {
        return task.userId === id;
    });
    showTasks(filtered);
}
</script>
</body>
</html>
